# Optional. Without a real key, /books/{id}/ask answers by quoting the book.
GROQ_API_KEY=your_groq_api_key_here

# Comma-separated browser origins allowed to call the API ("*" if unset).
CORS_ORIGINS=http://localhost:3600

# Where cached book text, passages and sentiment results are written.
# DATA_DIR=./data

# LOG_LEVEL=INFO
